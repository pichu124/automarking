# Copy to .env and fill in the key(s) for the provider(s) you want to use.
# You only need a key for the provider selected in the app's sidebar.

# --- Anthropic Claude (paid, highest quality, prompt caching) --------------
ANTHROPIC_API_KEY=sk-ant-...
# Effort for Claude grading: low | medium | high | max
GRADING_EFFORT=high
# Default Claude model (override the in-app default if you wish)
GRADING_MODEL=claude-opus-4-8

# --- Free / cheaper alternatives ------------------------------------------
# Google Gemini — generous FREE tier (aistudio.google.com)
GEMINI_API_KEY=
# Groq — FREE tier, very fast (console.groq.com)
GROQ_API_KEY=
# OpenRouter — aggregator, some free models (openrouter.ai)
OPENROUTER_API_KEY=
# DeepSeek — very low cost (platform.deepseek.com)
DEEPSEEK_API_KEY=
# Mistral (console.mistral.ai)
MISTRAL_API_KEY=
# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# Ollama needs NO key — install from ollama.com, run `ollama pull llama3.1`,
# and pick "Ollama (local, free)" in the sidebar.
