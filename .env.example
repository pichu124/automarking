# Copy to .env and fill in. The Anthropic SDK reads ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# GRADING_MODEL is the Claude model used for grading + rubric structuring.
GRADING_MODEL=claude-opus-4-8
# Effort for the grading calls: low | medium | high | max
GRADING_EFFORT=high
